{
  "manifest_version": 3,
  "name": "YT Music Remote",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Control YouTube Music from a remote. Unofficial, not affiliated with YouTube or Google.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["adapter.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YT Music Remote",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  }
}
